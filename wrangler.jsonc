{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker/entry.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Chat",
        "class_name": "Chat",
      },
      {
        "name": "RateLimiter",
        "class_name": "RateLimiter",
      },
    ],
  },
  "routes": [
    {
      "pattern": "www.bernardope.com",
      "custom_domain": true,
    },
    {
      "pattern": "bernardope.com",
      "custom_domain": true,
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimiter"],
    },
  ],
}
