#!/bin/sh
. "$(dirname "$0")/_/husky.sh"
# Run Biome to format and lint code
echo "Running pre-commit: biome format"
npm run --silent format || {
  echo "Format failed - aborting commit"
  exit 1
}
# Run linter and typecheck before commit
echo "Running pre-commit: lint and typecheck"
npm run --silent lint || {
  echo "Lint failed - aborting commit"
  exit 1
}
npm run --silent typecheck || {
  echo "Typecheck failed - aborting commit"
  exit 1
}

exit 0
